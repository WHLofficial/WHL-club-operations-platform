{
  "name": "whl-club",
  "private": true,
  "type": "module",
  "version": "6.1.0",
  "scripts": {
    "dev": "wrangler dev --port 8791",
    "dev:oidc": "wrangler dev --port 8795 --var OIDC_ISSUER:http://127.0.0.1:8792 --var OIDC_CLIENT_ID:club",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e/smoke.mjs",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply whl-club --local",
    "db:migrate:remote": "wrangler d1 migrations apply whl-club --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.1",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
