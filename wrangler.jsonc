{
  // 生产资源（2026-09-14 已建）：D1 whl-club + 自定义域 club.whleague.win（TECH_DESIGN §14.0）
  //   OIDC 模式由下方 vars（OIDC_ISSUER/OIDC_CLIENT_ID）开启；撤掉这两个变量重新部署即回兼容模式
  //   部署域必须是 .whleague.win 子域（认证中心与各系统同主域，Cookie 才有意义）
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whl-club",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  // v6.1.1：Sentry SDK（@sentry/hono/cloudflare → @sentry/cloudflare）依赖 AsyncLocalStorage，
  // 必须开 nodejs_compat（compatibility_date ≥ 2024-09-23 已满足）。
  // 回滚 = 删掉本行 + 撤 src/worker/index.ts 的 sentry 中间件。
  "compatibility_flags": ["nodejs_compat"],
  // v6.1.1：Sentry release 自动带上部署版本（SDK 从该绑定读 CF_VERSION_METADATA.id，
  // 优先级低于 SENTRY_RELEASE 环境变量，本仓不配后者）。
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whl-club",
      "database_id": "73154873-d5ae-42b0-a630-25f5ef60053d",
      "migrations_dir": "src/db/migrations"
    },
    {
      // 比赛系统 D1 只读绑定：账号与会话真源（TECH_DESIGN §3.1/§4），平台不写 user 表
      "binding": "TOUR_DB",
      "database_name": "whl",
      "database_id": "ec3cc695-70bc-47ab-a454-5ca62ec22dd6"
    },
    {
      // 认证中心 D1 只读绑定（增量 7）：球队绑定真源（team/team_binding），平台不写；
      // 发码/烧码/解绑走 auth 机器 API（AUTH_BIND_SECRET 为 secret：
      // npx wrangler secret put AUTH_BIND_SECRET，与 auth 仓 BIND_SECRET 同值）
      "binding": "AUTH_DB",
      "database_name": "whl-auth",
      "database_id": "b76d1129-77ae-4844-931c-1c7b00a9b048"
    }
  ],
  "kv_namespaces": [
    {
      // 共享会话 KV（与赛事/竞猜同一命名空间）：平台只读 sess:{token}
      "binding": "SESSION_KV",
      "id": "87e2d78308bc47e9b36dc6de53be0458"
    }
  ],
  "r2_buckets": [
    {
      // 队徽/媒体复用比赛系统桶 whl-media；本地 dev 自动模拟
      "binding": "MEDIA",
      "bucket_name": "whl-media"
    }
  ],
  // 统一认证中心（生产）：AUTH_MODE="oidc" 显式开启 RP 模式（增量 9 显式化），
  // 会话与 claims 由 auth 侧签发；撤掉 AUTH_MODE 重新部署即回兼容模式
  //
  // 增量 28：原来这里的 PUBLIC_CACHE_TTL_MS="20000" 已删——公开读缓存改「分级兜底 TTL」
  // （players 1h / roster 24h / clubs 24h，口径在 src/lib/cache-policy.ts），
  // 一个全局数字没法同时满足「列表键空间无穷」和「名册固定键单次 18301 行」这两种形状。
  // 变量本身仍受支持，作为显式覆盖（含 0=旁路），测试用。
  "vars": {
    "AUTH_MODE": "oidc",
    "OIDC_ISSUER": "https://auth.whleague.win",
    "OIDC_CLIENT_ID": "club",
    // 增量 31：球队详情代理比赛系统公开积分榜的基址（GET /api/public/tournaments/:id/standings）。
    // 与 src/worker/routes/auth.ts 的 TOUR_HOME 同一个源；撤掉这个变量 ⇒ 排名区块整体降级，页面照常。
    // 增量 34：必须是 tour 子域——apex whleague.win 不部署任何服务、也无 A 记录（配 apex 时每次
    // 代理都发一个必然 530 的请求，排名区块永久降级且只在日志里看得见）。
    "TOUR_API_BASE": "https://tour.whleague.win"
  },
  // 惰性结算 cron 兜底（§6.5）；扫描与结算逻辑已在 src/worker/index.ts 的 scheduled() 里实现
  // （runSettleTick：逾期结算 / 自动确认赛果 / 派发站内信；只有结算真写了公开数据才 purge 公开缓存）
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Smart Placement：靠近 D1（亚太）削减跨洋查询往返；部署后 ~15 分钟热身
  "placement": {
    "mode": "smart"
  },
  // 生产自定义域：club.whleague.win（DNS 与边缘证书由 Cloudflare 自动签发）
  "routes": [
    { "pattern": "club.whleague.win", "custom_domain": true }
  ]
}
