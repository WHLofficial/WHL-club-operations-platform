# 本地草稿区（探针脚本、e2e 失败截图、临时 SQL/KV 值）与会话交接草稿：不进仓库
scratch/
handoff-*.md

# 脑暴视觉伴侣的会话目录（.superpowers/brainstorm/<session>/ 下是本轮原型的 HTML 与状态）：
# 本地预览产物，不是仓库资产，不入库。
.superpowers/

# 离线导入生成物（30MB 级 SQL 分片）：可由 scripts/players-import/generate-sql.ts 逐字节复现，
# 入库的审计凭据是报告里的 sha256 清单，故分片本体不入库。
scripts/players-import/sql/

# 球员显示名派生物（增量 32）：data/ 是远端只读查询缓存，out/ 是生成的 SQL 与审计表，
# 都能由 scripts/player-names/derive.mjs 从本机 FC26 存档复现，故不入库。
scripts/player-names/data/
scripts/player-names/out/

# 2026-09-20/21 生产批的落库分片：旧值/守卫取自生成时点的生产库，不可逐字节复现，
# 可复现凭据是各目录的报告（含分片 sha256 与逐行明细）与已提交的 rollback/ 分片。
scripts/prod-20260920-s9-abilities/sql/
scripts/prod-20260920-s9-club-align/sql/
scripts/prod-20260920-s9-contracts/sql/
scripts/prod-20260921-s9-free-leftover/sql/

# 2026-10-05 生产批（合同导入 + 全库档位随机化）：合同批分片可由
# gen-cpu-contracts-sql.ts 从 CSV + 生产状态复现（报告含 sha256 与逐行明细），故分片不入库；
# 随机化批的分片是随机结果本体、不可复现，故入库，只排除可由 02-reroll.sql 反推的 manifest.json。
scripts/prod-20261005-s9-cpu-contracts/sql/
scripts/prod-20261005-s9-agent-reroll/sql/manifest.json

# 2026-10-06 期初对齐批（财政导入 + 工资 + 效力 + 标记落点）：写分片可由
# gen-opening-align.ts 从「一线队-S9.csv + snapshot.json」复现，故分片不入库；
# manifest.json（字节数/sha256/逐行明细）与只读预检/复查（01/06）、rollback/ 照旧入库。
scripts/prod-20261006-s9-opening-align/sql/0[2-5]-*.sql

# 2026-10-06 弃权场奖金订正批（收回 + 补发 + 上座清零）：写分片（02/03/04/06）可由
# gen-walkover-fix.ts 用 --ts=2026-10-06T04:23:06Z 逐字复现（报告含 sha256），故分片不入库；
# manifest.json（逐笔明细）、只读预检/复查（01/05）、rollback/ 与报告照旧入库。
scripts/prod-20261006-s9-walkover-fix/sql/0[2346]-*.sql
